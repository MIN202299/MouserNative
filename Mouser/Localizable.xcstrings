{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is running and will fight Mouser for device access. Quit it to avoid conflicts." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ 正在运行，会与 Mouser 争夺设备访问权。请退出它以避免冲突。" }
        }
      }
    },
    "A lightweight, fully local Logitech mouse remapper. No telemetry, no cloud, no Logitech account." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "轻量、完全本地的罗技鼠标按键映射工具。无遥测、无云端、无需罗技账号。" }
        }
      }
    },
